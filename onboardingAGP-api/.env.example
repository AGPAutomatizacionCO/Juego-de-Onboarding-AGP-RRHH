# =============================================================
# Plantilla de configuración de la API — onboardingAGP-api
# =============================================================
# Copiar como .env para desarrollo local. NUNCA versionar el .env
# real ni incluirlo en un paquete de despliegue.
#
# En Azure App Service estas variables NO van en archivo: se
# definen como "Configuración de la aplicación" del servicio.
# =============================================================

# --- Base de datos ---
# Servidor y base verificados contra el entorno real.
DB_SERVER="agpcolombia.database.windows.net"
DB_DATABASE="AGP_RRHH"
DB_PORT=1433

# ATENCIÓN — no reutilizar el usuario "Apps".
#
# El paquete original traía las credenciales de "Apps" en texto plano
# dentro del ZIP, por lo que deben considerarse comprometidas. Además
# ese login tiene roles db_datareader, db_datawriter y db_ddladmin
# sobre TODA la base AGP_RRHH: puede leer, escribir y eliminar
# cualquier objeto, no solo las 12 tablas del juego.
#
# Solicitar al administrador del servidor un login dedicado con
# permisos únicamente de lectura y escritura sobre las tablas
# dbo.Onboarding_*.
DB_USER="<usuario-dedicado-onboarding>"
DB_PASSWORD="<solicitar-al-administrador-del-servidor>"

# --- Servidor ---
# En App Service NO definir PORT: la plataforma la inyecta y el
# código ya la respeta (process.env.PORT || 3001).
PORT=3001
