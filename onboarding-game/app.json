        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/fondo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "runtimeVersion": {
